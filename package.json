{
  "name": "chadwick-quotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/deploy.ts && next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed:busbars": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/import-busbars.ts",
    "db:seed:vendor": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/import-vendor-catalog.ts",
    "db:export": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/export-catalog.ts",
    "db:import": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/import-catalog.ts",
    "db:seed:auth": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/seed-auth.ts",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" prisma/seed.ts"
  },
