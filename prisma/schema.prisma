generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quote {
  id                        String      @id @default(uuid())
  quoteNumber               String
  clientName                String?
  clientCompany             String?
  projectRef                String?
  description               String?
  status                    String      @default("DRAFT")
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  settingsSnapshot          String?
  globalDiscount            Float       @default(0)
  globalContingency         Float       @default(0)
  overrideLabourRate        Float?
  overrideOverheadPct       Float?
  overrideEngineeringPct    Float?
  overrideTargetMarginPct   Float?
  overrideConsumablesPct    Float?
  overrideGstPct            Float?
  overrideRoundingIncrement Int?
  overrideCopperPricePerKg  Float?
  revision                  Int         @default(0)
  createdBy                 String?
  lastModifiedBy            String?
  revisionGroupId           String?
  projectId                 String?
  gridInternalNotes         String?
  clientId                  String?
  contactId                 String?
  boards                    Board[]
  client                    Client?     @relation(fields: [clientId], references: [id])
  contact                   Contact?    @relation(fields: [contactId], references: [id])
  creator                   User?       @relation("QuoteCreator", fields: [createdBy], references: [id])
  modifier                  User?       @relation("QuoteModifier", fields: [lastModifiedBy], references: [id])
  project                   Project?    @relation(fields: [projectId], references: [id])
  shareLinks                ShareLink[]

  @@unique([quoteNumber, revision])
  @@index([clientId])
  @@index([contactId])
  @@index([projectId])
}

model Project {
  id                 String        @id @default(uuid())
  projectName        String
  clientName         String?
  projectStatus      ProjectStatus @default(Budget)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  companyName        String?
  projectDescription String?
  projectReference   String?
  clientId           String?
  contactId          String?
  import_batch_id    String?
  pipedrive_deal_id  Int?          @unique
  dealValue          Float?
  currency           String?
  dealCreatedAt      DateTime?
  expectedCloseDate  DateTime?
  quoteFolder        String?
  pipedriveDealUrl   String?
  pipedriveOwnerName String?
  pipedriveOwnerId   Int?
  source             String?
  client             Client?       @relation(fields: [clientId], references: [id])
  contact            Contact?      @relation(fields: [contactId], references: [id])
  importBatch        ImportBatch?  @relation(fields: [import_batch_id], references: [id])
  quotes             Quote[]

  @@index([pipedrive_deal_id])
  @@index([clientId])
  @@index([contactId])
  @@index([source, import_batch_id])
}

model Client {
  id               String       @id @default(uuid())
  name             String
  pipedrive_org_id Int?         @unique
  source           String       @default("pipedrive")
  import_batch_id  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  importBatch      ImportBatch? @relation(fields: [import_batch_id], references: [id])
  contacts         Contact[]
  projects         Project[]
  quotes           Quote[]

  @@index([pipedrive_org_id])
  @@index([source, import_batch_id])
}

model Contact {
  id                  String       @id @default(uuid())
  name                String
  email               String?
  phone               String?
  pipedrive_person_id Int?         @unique
  clientId            String?
  source              String       @default("pipedrive")
  import_batch_id     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  client              Client?      @relation(fields: [clientId], references: [id])
  importBatch         ImportBatch? @relation(fields: [import_batch_id], references: [id])
  projects            Project[]
  quotes              Quote[]

  @@index([pipedrive_person_id])
  @@index([clientId])
  @@index([source, import_batch_id])
}

model ImportBatch {
  id                     String    @id @default(uuid())
  source                 String    @default("pipedrive")
  status                 String    @default("PENDING")
  createdAt              DateTime  @default(now())
  startedAt              DateTime  @default(now())
  lastHeartbeatAt        DateTime  @default(now())
  completedAt            DateTime?
  totalClientsAttempted  Int       @default(0)
  totalContactsAttempted Int       @default(0)
  totalProjectsAttempted Int       @default(0)
  totalClientsCommitted  Int       @default(0)
  totalContactsCommitted Int       @default(0)
  totalProjectsCommitted Int       @default(0)
  skippedDeals           Int       @default(0)
  errorLog               Json?
  clients                Client[]
  contacts               Contact[]
  projects               Project[]

  @@index([status, lastHeartbeatAt])
}

model User {
  id              String           @id @default(uuid())
  name            String?
  email           String?          @unique
  password        String?
  emailVerified   DateTime?
  image           String?
  status          String           @default("ACTIVE")
  lastLogin       DateTime?
  roleId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  createdQuotes   Quote[]          @relation("QuoteCreator")
  modifiedQuotes  Quote[]          @relation("QuoteModifier")
  sessions        Session[]
  role            Role?            @relation(fields: [roleId], references: [id])
  userPermissions UserPermission[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  timestamp DateTime @default(now())
}

model ShareLink {
  id        String    @id @default(uuid())
  quoteId   String
  token     String    @unique
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Board {
  id            String   @id @default(uuid())
  quoteId       String
  name          String
  type          String?
  order         Int      @default(0)
  isOptional    Boolean  @default(false)
  config        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  mccbVariant   String?
  description          String?
  internalNotes        String?
  useCustomDescription Boolean  @default(false)
  hideAutoDescription  Boolean  @default(false)
  customDescription    String?
  descriptionOptions   Json     @default("{}")
  quote                Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items                Item[]
}

model Item {
  id              String   @id @default(uuid())
  boardId         String
  category        String
  subcategory     String?
  name            String
  description     String?
  quantity        Decimal  @default(1) @db.Decimal(10, 3)
  unitPrice       Float    @default(0)
  labourHours     Float    @default(0)
  cost            Float    @default(0)
  notes           String?
  isDefault       Boolean  @default(false)
  isSheetmetal    Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isSystemManaged Boolean  @default(false)
  partNumber      String?
  productFrame    String?
  mccbVariant     String?
  systemTag       String?
  systemRuleType  String?
  autoAdded       Boolean  @default(false)
  parentItemId    String?
  isIncluded      Boolean  @default(true)
  mergeable       Boolean  @default(true)
  board           Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parentItem      Item?    @relation("ItemDependencies", fields: [parentItemId], references: [id], onDelete: Cascade)
  children        Item[]   @relation("ItemDependencies")

  @@unique([boardId, systemRuleType, partNumber, parentItemId])
}

model CatalogItem {
  id                          String   @id @default(uuid())
  brand                       String?
  category                    String?
  subcategory                 String?
  partNumber                  String?
  description                 String
  unitPrice                   Float    @default(0)
  labourHours                 Float    @default(0)
  imageUrl                    String?
  isAutoAdd                   Boolean  @default(false)
  defaultQuantity             Int      @default(1)
  notes                       String?
  meterType                   String?
  isSheetmetal                Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  productFrame                String?
  mccbRole                    String?
  mccbVariant                 String?
  isCopperPriced              Boolean  @default(false)
  totalCopperWeightKgPerMeter Float?
  components                  Json?

  @@unique([partNumber, brand])
}

model MccbTripBaseRule {
  id             String   @id @default(uuid())
  tripPartNumber String
  variant        String
  basePartNumber String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tripPartNumber, variant])
}

model Settings {
  id                String   @id @default("global")
  labourRate        Float    @default(100)
  consumablesPct    Float    @default(0.03)
  overheadPct       Float    @default(0.20)
  engineeringPct    Float    @default(0.20)
  targetMarginPct   Float    @default(0.18)
  gstPct            Float    @default(0.10)
  roundingIncrement Int      @default(100)
  minMarginAlertPct Float    @default(0.05)
  companyName       String?
  companyAddress    String?
  updatedAt         DateTime @updatedAt
  copperPricePerKg  Float    @default(15.0)
  pipedriveToken    String?
}

model PairingRule {
  id               String   @id @default(uuid())
  ruleType         String
  inputPartNumber  String
  outputPartNumber String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ruleType, inputPartNumber])
}

model Template {
  id           String   @id @default(cuid())
  name         String
  filename     String
  originalName String
  size         Int
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model QuoteSequence {
  id         String   @id @default(uuid())
  year       Int      @unique
  lastNumber Int
  updatedAt  DateTime @updatedAt
}

enum ProjectStatus {
  Budget
  Tender
  Live
}
